filters:
  and:
    - file.ext == "md"
    - file.path.startsWith("05 Knowledge/")
views:
  - type: table
    name: Knowledge notes
    filters: note.type != "index"
    order:
      - file.name
      - file.folder
      - type
      - status
      - source
      - file.mtime
  - type: table
    name: Cloud and DevOps
    filters: note.area == "cloud-devops"
    order:
      - file.name
      - file.folder
      - type
      - status
      - source
      - file.mtime
  - type: table
    name: Programming
    filters: note.area == "programming"
    order:
      - file.name
      - file.folder
      - type
      - status
      - source
      - file.mtime
